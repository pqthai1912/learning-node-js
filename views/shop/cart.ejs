<%- include('../includes/head.ejs') %>
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <% if (products.length > 0) { %>
                <ul>
                    <% products.forEach(product => { %>
                        <li>
                            <span class="product__title"><%= product.title %></span>
                            <span class="product__qty">Qty: <%= product.cartItem.quantity %></span>
                            <span class="product__price">Price: $<%= product.price %></span>
                            <span class="product__total">Total: $<%= product.cartItem.quantity * product.price %></span>
                            <form action="/cart-delete-item" method="POST">
                                <button type="submit" name="productId" value="<%= product.cartItem.id %>">Delete</button">
                            </form>
                        </li>
                    <% }) %>
                </ul>
                <div class="centered">
                    <form action="/create-order" method="POST">
                        <button class="btn" type="submit">Order</button>
                    </form>
                </div> 
            <% } else { %>
                <h1>No Products in cart</h1>
            <% } %>
        </main>
        <%- include('../includes/end.ejs') %>