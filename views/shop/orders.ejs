<%- include('../includes/head.ejs') %>
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <h1>Orders</h1>
            <% orders.forEach(order => { %>
                <h1>#<%= order.id %></h1>
                <ul>
                    <% order.products.forEach(product => { %>
                        <li>
                            <span class="product__title"><%= product.title %></span>
                            <span class="product__qty">Qty: <%= product.quantity %></span>
                            <span class="product__price">Price: $<%= product.OrderItem.price %></span>
                            <span class="product__total">Total: $<%= product.OrderItem.quantity * product.price %></span>
                        </li>
                        <% }) %>
                    </ul>
                    <div class="order__total">
                        <span>Total: $<%= order.totalPrice %></span>
                        <span>Total items: $<%= order.totalItems %></span>
                    </div>
                <% }) %>
        </main>
        <%- include('../includes/end.ejs') %>